{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "backend": {
            "root": "backend",
            "framework": "express"
        },
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "service": "backend",
            "path": "/api/$1"
        },
        {
            "source": "/(.*)",
            "service": "frontend",
            "path": "/$1"
        }
    ]
}